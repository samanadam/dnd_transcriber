# Copy to .env and fill in. No Discord token here - this half never talks to
# Discord, which is the whole point of the split.

# --- How we reach the recorder ----------------------------------------------
# local = SSH (or plain directories when REMOTE_HOST is empty).
# r2    = Cloudflare R2. Nothing here needs to be reachable from outside and the
#         recorder needs no SSH account for us: both halves talk outbound only.
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=r2. Must be the SAME bucket the recorder
# writes to, with an "Object Read & Write" token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2 doubles as the permanent audio archive, so collecting a session leaves its
# objects in place. Set false to delete each session from R2 once transcribed -
# the workspace archive/ directory here is then your only copy.
R2_KEEP_AUDIO=true

# --- Where the recorder is (STORAGE_BACKEND=local) ---------------------------
# Leave REMOTE_HOST empty to work against local directories instead of SSH,
# which is how the pipeline is tested on one machine.
REMOTE_HOST=
REMOTE_USER=
SSH_PORT=22
# Path to an SSH private key. Empty uses your agent / default key.
SSH_KEY=
# Directories on the recorder.
REMOTE_OUTBOX=/srv/dnd-bot-data/outbox
REMOTE_INBOX=/srv/dnd-bot-data/inbox

# --- Local workspace --------------------------------------------------------
# incoming/ outgoing/ archive/ failed/ live under here. The archive is your
# permanent copy of the audio, so put this somewhere with room.
WORKSPACE_DIR=./workspace

# --- Whisper ----------------------------------------------------------------
# medium gives noticeably better Turkish accuracy than small, and is slow on CPU.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Keep false: per-speaker tracks are mostly silence, and carrying context across
# those gaps is what makes Whisper loop the same sentence over and over.
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_VAD_MIN_SILENCE_MS=500
# Drop subtitle-boilerplate hallucinations and stuck repeats.
FILTER_HALLUCINATIONS=true
# Memory ceiling: each track is transcribed in chunks of this many minutes.
TRANSCRIBE_CHUNK_MINUTES=10
# Where the model is cached. Empty uses the faster-whisper default.
WHISPER_CACHE_DIR=

# --- When this machine is willing to work -----------------------------------
# Off by default: you run `dndt session` yourself. Turn on if you script it.
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=00:00
QUIET_HOURS_END=08:00
TIMEZONE=Europe/Istanbul

LOG_LEVEL=INFO
